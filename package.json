{
  "name": "western-water-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --open /",
    "build": "tsc --noEmit && vitest run && npm run budget:sdk && vite build",
    "verify:fast": "tsc --noEmit && vitest run",
    "verify:frontend": "npm run build",
    "verify:pipeline": "scripts/verify-pipeline.sh -q",
    "verify:browser": "scripts/verify-browser.sh",
    "verify:all": "npm run verify:frontend && npm run verify:pipeline && npm run verify:browser",
    "budget:sdk": "node scripts/check-sdk-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node tests/smoke.mjs",
    "smoke:modern": "node tests/smoke-modern.mjs",
    "boundary:utah": "node scripts/fetch-utah-boundary.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@arcgis/charts-components": "^5.1.0",
    "@arcgis/common-components": "^5.1.0",
    "@arcgis/core": "^5.1.0",
    "@arcgis/map-components": "^5.1.0",
    "@esri/calcite-components": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "axe-core": "^4.13.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
